<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_line_form_view_inherit" model="ir.ui.view">
            <field name="name">sale.order.form.view.inherit</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                    <field name="component_product_id" optional="show"/>
                    <field name="component_lot_id" optional="show"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>