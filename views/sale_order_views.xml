<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_custom_lot" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.lot</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add to list view in order_line -->
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="component_lot_id" optional="show"/>
            </xpath>
            <!-- Add to form view in order_line -->
            <xpath expr="//field[@name='order_line']/form/group/group/field[@name='product_uom_qty']" position="after">
                <field name="component_lot_id"/>
            </xpath>
        </field>
    </record>
</odoo>